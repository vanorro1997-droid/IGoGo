# Скопируйте в .env только если у вас ещё нет своего файла с настройками.
# Секреты заполняются локально; не публикуйте .env в Git.

# HTTP-сервер и каталог интерфейса.
# HTTP_PORT имеет приоритет над прежним именем PORT.
HTTP_PORT=8080
FRONTEND_DIR=frontend

# Необязательно: образы сборки и запуска Docker (не используются при go run).
# По умолчанию официальные multi-arch образы закреплены в Dockerfile/Compose.
# При недоступности Amazon ECR Public можно выбрать тот же digest из Docker Hub:
# GO_IMAGE=golang:1.26.5-alpine3.23@sha256:622e56dbc11a8cfe87cafa2331e9a201877271cbff918af53d3be315f3da88cc
# ALPINE_IMAGE=alpine:3.23.8@sha256:469c9ea410b9215eaee7976ba6c0639039b444be8e5d638f7abbada189971eb2
# Инструкция: docs/docker.md.

# Источник станций и расписаний: mock (без сети) или yandex.
# Для Яндекс Расписаний установите TRANSPORT_PROVIDER=yandex и заполните ключ.
# Ключ: https://yandex.ru/dev/rasp/ ; прежнее имя YANDEX_API_KEY тоже поддерживается.
TRANSPORT_PROVIDER=mock
YANDEX_RASP_API_KEY=

# Источник прогноза /api/weather?lat=...&lon=...: mock или open-meteo.
# Open-Meteo не требует ключа.
WEATHER_PROVIDER=mock

# Ключ WeatherAPI для текущей погоды /api/weather?location=... (используется UI).
WEATHERAPI_KEY=
# Ключ каталога 2GIS для /api/2gis/search.
TWOGIS_API_KEY=

# PostgreSQL: true включает БД, авторизацию и историю запросов.
# false позволяет запустить API без БД. Без DB_ENABLED наличие DB_* включает БД.
# В Docker Compose DB_HOST и внутренний DB_PORT задаются как postgres и 5432.
# Пароль ниже — только пример для локальной разработки, замените его.
DB_ENABLED=true
# Необязательно: образ БД для Docker Compose, не используется при go run.
# По умолчанию PostgreSQL 15.20 / Alpine 3.23 закреплён по multi-arch digest.
# Для Docker Hub или своего registry можно переопределить образ, сохраняя PostgreSQL 15:
# POSTGRES_IMAGE=postgres:15.20-alpine3.23@sha256:83bdbdd781076b1543709883a93d995b53e682b078ea30e3cea012856732d1e5
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change_me
DB_NAME=igogo
DB_SSLMODE=disable
# Срок действия пользовательской сессии в часах.
SESSION_TTL_HOURS=168

# Cloudflare Workers AI для /api/llm: ключ и аккаунт нужны только при true.
LLM_ENABLED=false
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/google/gemma-4-26b-a4b-it
CLOUDFLARE_SYSTEM_PROMPT=
# Необязательный прокси только для LLM; иначе используется HTTPS_PROXY.
CLOUDFLARE_PROXY=

# Необязательный общий прокси для внешних HTTP(S) API.
# В контейнере адрес 127.0.0.1 указывает на сам контейнер, а не на компьютер.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,postgres

# Только для интеграционных тестов с отдельной тестовой БД:
# IGOGO_TEST_DATABASE_URL=postgres://postgres:change_me@localhost:5432/igogo_test?sslmode=disable
